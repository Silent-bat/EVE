{
  "name": "eve",
  "version": "0.2.0",
  "private": true,
  "description": "EVE / BriefOS personal agent workspace",
  "packageManager": "pnpm@10.13.1",
  "workspaces": [
    "apps/mobile",
    "services/api-node"
  ],
  "scripts": {
    "api:start": "pnpm --filter @eve/api start",
    "api:test": "pnpm --filter @eve/api test",
    "api:typecheck": "pnpm --filter @eve/api typecheck",
    "mobile:start": "pnpm --filter @eve/mobile start",
    "mobile:test": "pnpm --filter @eve/mobile test",
    "mobile:typecheck": "pnpm --filter @eve/mobile typecheck",
    "typecheck": "pnpm api:typecheck && pnpm mobile:typecheck",
    "test": "pnpm api:test && pnpm mobile:test",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint --fix .",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "preview": "node apps/preview/server.mjs"
  },
  "dependencies": {
    "eas-cli": "^20.0.0"
  }
}
