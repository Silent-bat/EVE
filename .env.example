API_HOST=127.0.0.1
API_PORT=8080
EVE_DATA_DIR=.eve-data

# Optional. When set, the Node V1 API stores auth, sessions, app state, and
# captured Android notifications in Postgres. Keep the real value out of git.
DATABASE_URL=
AUTH_TOKEN_TTL_DAYS=30

# For iOS simulator/web, localhost works. For a physical phone, set this to
# your computer LAN URL, for example http://192.168.1.197:8080.
EXPO_PUBLIC_EVE_API_URL=http://127.0.0.1:8080

# Optional. When unset, Google login, Gmail, Calendar, and Gmail send are disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/google/callback

# Optional. When unset, V1 uses deterministic local parsing/drafting fallback.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
