# Copy this file to .env and fill in real values. .env is gitignored.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
EVE_DATA_DIR=.eve-data
LOG_LEVEL=info

# Session lifetime
AUTH_TOKEN_TTL_DAYS=30

# Rate limits on /v1/auth/* — 429 once exceeded
AUTH_RATELIMIT_IP_PER_MIN=5
AUTH_RATELIMIT_EMAIL_PER_15MIN=20

# Set to true ONLY when the API sits behind a proxy you control (nginx, ALB,
# Cloud Run) that overwrites X-Forwarded-For. It makes the per-IP rate limit
# read that header, which a client can otherwise forge to get a fresh bucket
# per request. Left false, the limiter uses the real socket address.
TRUST_PROXY=false

# Largest JSON body the API will buffer, in bytes. Bodies are read into memory,
# so this is the cap that stops one request from exhausting the heap.
MAX_BODY_BYTES=1048576

# Upstream request/database timeouts (milliseconds).
OUTBOUND_TIMEOUT_MS=15000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Remote Postgres connections verify certificates by default. The bundled
# local Docker service is detected by hostname and uses plaintext automatically.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Required in production; use a secret-manager value, not a checked-in key.
STATE_ENCRYPTION_KEY=

# Authenticated AI/voice budgets.
# Applies independently to each authenticated AI/Gmail route and each Live
# tool category, so a voice Gmail flood cannot consume the memory/action budget.
USER_RATELIMIT_PER_MIN=30
VOICE_MAX_CONNECTIONS_PER_USER=2
VOICE_MAX_AUDIO_BYTES=2000000
VOICE_MAX_SESSION_MS=900000
VOICE_IDLE_TIMEOUT_MS=600000

# Provider/model resource limits.
GOOGLE_RESPONSE_MAX_BYTES=2000000
GMAIL_MAX_BODY_CHARS=20000
GMAIL_FETCH_CONCURRENCY=6
GEMINI_PROMPT_MAX_CHARS=120000
# Captured Android notification previews are automatically deleted after this
# many days. Users can also clear them immediately from Settings.
DEVICE_NOTIFICATION_RETENTION_DAYS=30

# Required in production. Development/test may leave this blank to use the
# private JSON fallback at EVE_DATA_DIR. Never commit a real connection string.
DATABASE_URL=

# Optional comma-separated browser origins, for example:
# https://app.example.com,https://admin.example.com
# Native clients do not need CORS. In production an empty list denies browser
# cross-origin access; development uses a wildcard when this is blank.
CORS_ORIGINS=

# Mobile app uses this to reach the backend. For iOS simulator/web, localhost
# is fine. For a physical phone, set to your computer's LAN URL.
EXPO_PUBLIC_EVE_API_URL=http://127.0.0.1:8080

# Google OAuth. Leave blank to disable. If GOOGLE_CLIENT_ID is set, the API
# refuses to boot without GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/google/callback

# LLM keys. Optional — without them, briefing scoring and the assistant use
# the local heuristic fallback.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
