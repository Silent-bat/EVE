# Copy this file to .env and fill in real values. .env is gitignored.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
EVE_DATA_DIR=.eve-data
LOG_LEVEL=info

# Session lifetime
AUTH_TOKEN_TTL_DAYS=30

# Rate limits on /v1/auth/* — 429 once exceeded
AUTH_RATELIMIT_IP_PER_MIN=5
AUTH_RATELIMIT_EMAIL_PER_15MIN=20

# Set to true ONLY when the API sits behind a proxy you control (nginx, ALB,
# Cloud Run) that overwrites X-Forwarded-For. It makes the per-IP rate limit
# read that header, which a client can otherwise forge to get a fresh bucket
# per request. Left false, the limiter uses the real socket address.
TRUST_PROXY=false

# Largest JSON body the API will buffer, in bytes. Bodies are read into memory,
# so this is the cap that stops one request from exhausting the heap.
MAX_BODY_BYTES=1048576

# Optional. When set, the API stores users + sessions + app state + captured
# Android notifications in Postgres. When unset, EVE_DATA_DIR/state.json is used.
# Never commit a real connection string.
DATABASE_URL=

# Mobile app uses this to reach the backend. For iOS simulator/web, localhost
# is fine. For a physical phone, set to your computer's LAN URL.
EXPO_PUBLIC_EVE_API_URL=http://127.0.0.1:8080

# Google OAuth. Leave blank to disable. If GOOGLE_CLIENT_ID is set, the API
# refuses to boot without GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/google/callback

# LLM keys. Optional — without them, briefing scoring and the assistant use
# the local heuristic fallback.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
