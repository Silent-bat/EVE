/**
 * Ported encryption logic for Google tokens (AES-256-GCM)
 */
import { internal } from "./_generated/api";
import { Doc, Id } from "./_generated/dataModel";
import { v } from "convex/values";
import { mutation, query, action, internalMutation, internalAction } from "./_generated/server";

// Same as existing: eve:v1: prefix
const VERSION = "eve:v1:";

/**
 * Hash a passphrase/hex/base64 key into a 32-byte AES key
 */
function keyBytes(configuredKey: string): Uint8Array | null {
  if (!configuredKey) return null;

  // 64 hex chars = 32 bytes
  if (/^[0-9a-f]{64}$/i.test(configuredKey)) {
    const bytes = new Uint8Array(32);
    for (let i = 0; i < 32; i++) {
      bytes[i] = parseInt(configuredKey.substr(i * 2, 2), 16);
    }
    return bytes;
  }

  // Try base64 first
  try {
    const decoded = atob(configuredKey);
    if (decoded.length === 32) {
      const bytes = new Uint8Array(32);
      for (let i = 0; i < 32; i++) {
        bytes[i] = decoded.charCodeAt(i);
      }
      return bytes;
    }
  } catch {
    // fall through
  }

  // Hash a passphrase with SHA-256
  // Convex doesn't have Node crypto, but we can use the Web Crypto API in actions
  // For Node actions, use the Node crypto module
  return null;
}

/**
 * Encrypt a secret value (Google tokens) with AES-256-GCM
 */
export async function encryptSecret(value: any): Promise<string> {
  const configured = process.env.STATE_ENCRYPTION_KEY;
  if (!configured) {
    if (process.env.NODE_ENV === "production") {
      throw new Error("STATE_ENCRYPTION_KEY is required to persist secrets");
    }
    return JSON.stringify(value); // dev fallback: store as plain JSON
  }

  // Use Web Crypto API in Convex
  const keyMaterial = await crypto.subtle.importKey(
    "raw",
    typeof configured === "string"
      ? await crypto.subtle.digest("SHA-256", new TextEncoder().encode(configured))
      : configured,
    { name: "AES-GCM" },
    false,
    ["encrypt", "decrypt"]
  );

  const iv = crypto.getRandomValues(new Uint8Array(12));
  const encoded = new TextEncoder().encode(JSON.stringify(value));
  const ciphertext = await crypto.subtle.encrypt(
    { name: "AES-GCM", iv },
    keyMaterial,
    encoded
  );

  const ciphertextArray = new Uint8Array(ciphertext);
  const tagArray = ciphertextArray.slice(-16); // GCM tag is last 16 bytes
  const actualCiphertext = ciphertextArray.slice(0, -16);

  // Encode all as base64url
  const ivText = btoa(String.fromCharCode(...iv)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");
  const tagText = btoa(String.fromCharCode(...tagArray)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");
  const cipherText = btoa(String.fromCharCode(...actualCiphertext)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");

  return `${VERSION}${ivText}.${tagText}.${cipherText}`;
}

/**
 * Decrypt a secret value
 */
export async function decryptSecret(value: string): Promise<any> {
  if (typeof value !== "string" || !value.startsWith(VERSION)) {
    // Dev fallback: if it's not encrypted, try to parse it
    try {
      return JSON.parse(value);
    } catch {
      return value;
    }
  }

  const configured = process.env.STATE_ENCRYPTION_KEY;
  if (!configured) {
    throw new Error("STATE_ENCRYPTION_KEY is required to decrypt persisted secrets");
  }

  const encoded = value.slice(VERSION.length).split(".");
  if (encoded.length !== 3) {
    throw new Error("invalid encrypted secret envelope");
  }

  const [ivText, tagText, cipherText] = encoded;

  // Decode base64url
  const iv = new Uint8Array(
    atob(ivText.replace(/-/g, "+").replace(/_/g, "/")).split("").map(c => c.charCodeAt(0))
  );
  const tag = new Uint8Array(
    atob(tagText.replace(/-/g, "+").replace(/_/g, "/")).split("").map(c => c.charCodeAt(0))
  );
  const ciphertext = new Uint8Array(
    atob(cipherText.replace(/-/g, "+").replace(/_/g, "/")).split("").map(c => c.charCodeAt(0))
  );

  // Combine ciphertext and tag (Web Crypto expects tag at the end)
  const combined = new Uint8Array(ciphertext.length + tag.length);
  combined.set(ciphertext);
  combined.set(tag, ciphertext.length);

  const keyMaterial = await crypto.subtle.importKey(
    "raw",
    await crypto.subtle.digest("SHA-256", new TextEncoder().encode(configured)),
    { name: "AES-GCM" },
    false,
    ["encrypt", "decrypt"]
  );

  const plaintext = await crypto.subtle.decrypt(
    { name: "AES-GCM", iv },
    keyMaterial,
    combined
  );

  return JSON.parse(new TextDecoder().decode(plaintext));
}
