# EVE Convex Configuration
#
# Copy this to .env.local and fill in your values.
#
# For production, set these in your Convex dashboard.

# Convex
CONVEX_DEPLOYMENT=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/google/callback

# LLM keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Encryption for stored Google tokens
STATE_ENCRYPTION_KEY=

# Limits
AUTH_TOKEN_TTL_DAYS=30
OUTBOUND_TIMEOUT_MS=15000
GOOGLE_RESPONSE_MAX_BYTES=2000000
GMAIL_MAX_BODY_CHARS=20000
GMAIL_FETCH_CONCURRENCY=6
GEMINI_PROMPT_MAX_CHARS=120000
DEVICE_NOTIFICATION_RETENTION_DAYS=30
